JSP404.FullClassification : Prop
JSP404.ThresholdLowerBounds : Prop
@JSP404.exactValue_isLUB : ∀ {n : ℕ} {a : ℝ}, JSP404.ExactValue n a → IsLUB {b | JSP404.Unavoidable n b} a
@JSP404.unavoidable_mono : ∀ {m n : ℕ} {a : ℝ}, m ≤ n → JSP404.Unavoidable m a → JSP404.Unavoidable n a
@JSP404.approximableCap_mono : ∀ {m n : ℕ} {a : ℝ}, m ≤ n → JSP404.ApproximableCap n a → JSP404.ApproximableCap m a
