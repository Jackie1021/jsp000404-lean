  JSP404.ExactValue 4 (Real.pi / 2) →
    JSP404.ThresholdLowerBounds →
      (∀ (m : ℕ), 2 ≤ m → JSP404.ApproximableCap (JSP404.transition m) (JSP404.firstValue m)) →
        (∀ (m : ℕ), 2 ≤ m → JSP404.ApproximableCap (2 ^ (m + 1)) (JSP404.secondValue m)) → JSP404.FullClassification
